# =============================================================================
# 天然气市场需求预测 / 今冬明春预测智能体 — 环境变量模板
#
# 使用方式（在项目根目录）：
#   Windows:  copy .env.example .env
#   Linux:     cp .env.example .env
#   然后编辑 .env，填入你的 API Key 与模型名
#
# 注意：.env 含密钥，不要打包进 zip 外传；只分发本文件 .env.example
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API（必填，否则智能体无法解析意图 / 推荐特征 / 问答）
# -----------------------------------------------------------------------------
OPENAI_API_KEY=请填写你的_API_Key
OPENAI_BASE_URL=https://你的兼容接口地址/v1

# 对话模型（意图解析、特征推荐、continue 确认、完成后追问均会用到）
CHAT_MODEL=请填写模型名

# 可选：若推理与对话分开配置
# REASONING_MODEL=请填写推理模型名

# -----------------------------------------------------------------------------
# 燃气预测数据与输出（一般保持默认即可）
# -----------------------------------------------------------------------------
# 省级 Excel 所在目录，文件命名：{省份}.xlsx，如 河北.xlsx、江苏.xlsx
FORECAST_DATA_DIR=data/processed_data

# 预测结果根目录（Web 智能体会在其下创建 {省份}/agent_flow_时间戳/）
FORECAST_OUTPUT_DIR=forecast_agent_output

# 对话未提及省份时的默认省份
FORECAST_DEFAULT_PROVINCE=河北

# -----------------------------------------------------------------------------
# 可选：LLM 调用参数
# -----------------------------------------------------------------------------
CHAT_MAX_TOKENS=4000
CHAT_TEMPERATURE=0.7
MAX_RETRY=5
RETRY_WAIT_SECONDS=5

# -----------------------------------------------------------------------------
# 可选：Copernicus CDS（仅 scripts/weather 下载气温 NetCDF 时需要）
# Web「天气预测」页只读已有 CSV 时可不配置
# -----------------------------------------------------------------------------
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=请填写_Copernicus_Personal_Access_Token

# -----------------------------------------------------------------------------
# 以下仅在使用「因子挖掘 / Qlib 回测」时需要；仅跑今冬明春预测可忽略
# -----------------------------------------------------------------------------
# QLIB_DATA_DIR=
# DATA_RESULTS_DIR=
# QLIB_PROVIDER_URI=
